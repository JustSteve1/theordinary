config {
  type: "table",
  schema: "ordinary_core",
  tags: ["spine"],
  description: "Latest recovery per record. Tombstones are dropped. record_id is the cycle id."
}

select * except (row_num)
from (
  select
    *,
    row_number() over (
      partition by member_key, record_id
      order by record_updated_at desc nulls last, ingested_at desc
    ) as row_num
  from ${ref("whoop_recovery")}
)
where row_num = 1
  and deleted is not true
