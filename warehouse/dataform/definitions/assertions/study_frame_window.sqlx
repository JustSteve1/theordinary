config { type: "assertion", schema: "ordinary_effects", tags: ["studies"] }

select f.member_key, f.experiment_id, f.version, f.date, f.measure_id
from ${ref("study_frame_long")} f
join ${ref("study_enrolments")} e
  using (member_key, experiment_id, version)
where f.date < e.study_start
   or f.date > e.study_end
