# Copy to .env.local for local development

# Public site URL (used for metadata and OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true when ready to launch the full site
NEXT_PUBLIC_SITE_LAUNCHED=false

# Optional: bypass the coming-soon gate in production for testing
# Visit /app?preview=<secret> to enable preview mode for 7 days
SITE_PREVIEW_SECRET=

# Signs the member session cookie. Use at least 16 characters.
SESSION_SECRET=

# Local Bee proxy started with `bee proxy`
BEE_PROXY_URL=http://127.0.0.1:8787

# WHOOP OAuth app. Leave blank until the developer app exists.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback
