# Copy to .env.local for local development

# Public site URL (used for metadata and OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true when ready to launch the full site
NEXT_PUBLIC_SITE_LAUNCHED=false

# Optional: bypass the coming-soon gate in production for testing
# Visit /app?preview=<secret> to enable preview mode for 7 days
SITE_PREVIEW_SECRET=

# Signs the member session cookie. Use at least 16 characters.
SESSION_SECRET=

# Postgres connection string. Local development uses the local database.
# Production already uses the hosted Neon pooler over TLS. Set that on
# Vercel, not in this file.
DATABASE_URL=

# Local development only. A hosted deploy never seeds this account.
USER1_EMAIL=steve@440hz.uk
USER1_NAME=Steve Fortuin
USER1_PASSWORD=

# Verification and password-reset mail. Leave blank in development to
# print the link on screen. Production sends through Resend and fails
# closed when either value is missing.
RESEND_API_KEY=
EMAIL_FROM=

# Local Bee proxy started with `bee proxy`
BEE_PROXY_URL=http://127.0.0.1:8787

# Amazon Bedrock. Nova Lite answers the dashboard chat from the member record.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# WHOOP OAuth app. Leave blank until the developer app exists.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback

# Warehouse. Leave blank locally until bootstrap.out.env exists.
# BQ_LOCATION must be europe-west2. Never point this at another region.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
BQ_LOCATION=
WAREHOUSE_IMPERSONATE=
MEMBER_KEY_SECRET=
CRON_SECRET=
EXPERIMENT_SALT=

# In-app nudges. Off unless this is exactly true. NUDGE_SALT must be at least 32 characters.
NUDGES_ENABLED=false
NUDGE_SALT=
