# Copy to .env.local for local development

# Public site URL (used for metadata and OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true when ready to launch the full site
NEXT_PUBLIC_SITE_LAUNCHED=false

# Optional: bypass the coming-soon gate in production for testing
# Visit /app?preview=<secret> to enable preview mode for 7 days
SITE_PREVIEW_SECRET=

# Signs the member session cookie. Use at least 16 characters.
SESSION_SECRET=

# Supabase Postgres connection string. Use the transaction pooler URI
# (port 6543) from Project Settings → Database. Server only.
DATABASE_URL=

# Creates this member on first sign-in when the email is not stored yet.
USER1_EMAIL=steve@440hz.uk
USER1_NAME=Steve Fortuin
USER1_PASSWORD=

# Local Bee proxy started with `bee proxy`
BEE_PROXY_URL=http://127.0.0.1:8787

# WHOOP OAuth app. One app for every member. Redirect must match the app.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://theordinary.club/api/whoop/callback

# Amazon Bedrock Converse. Server only. The key needs bedrock:InvokeModel
# in AWS_REGION for BEDROCK_MODEL_ID.
AWS_REGION=eu-west-2
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-5
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Lets the machine running bee proxy post a Bee brief.
BEE_SYNC_SECRET=
