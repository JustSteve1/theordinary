# Copy to .env.local for local development

# Public site URL (used for metadata and OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true when ready to launch the full site
NEXT_PUBLIC_SITE_LAUNCHED=false

# Optional: bypass the coming-soon gate in production for testing
# Visit /app?preview=<secret> to enable preview mode for 7 days
SITE_PREVIEW_SECRET=
