{
  "name": "theordinary",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:scoring": "tsx --test src/platform/scoring/scoring.test.ts src/platform/integrations/bee-export.test.ts",
    "test:warehouse": "tsx --test src/platform/warehouse/warehouse.test.ts src/platform/integrations/whoop-sync.test.ts src/platform/integrations/whoop-refresh.test.ts src/platform/experiments/*.test.ts src/features/demo/demo.test.ts",
    "test:nudges": "tsx --test src/platform/nudges/nudges.test.ts",
    "warehouse:ensure": "tsx scripts/warehouse-ensure.ts",
    "warehouse:status": "tsx scripts/warehouse-status.ts",
    "warehouse:land-user1": "tsx scripts/warehouse-land-user1.ts",
    "experiments:activate": "tsx scripts/experiments-activate.ts",
    "experiments:end": "tsx scripts/experiments-end.ts",
    "partner:sample-file": "tsx scripts/partner-sample-file.ts",
    "partner:import": "tsx scripts/partner-import.ts",
    "demo:snapshot": "tsx scripts/demo-snapshot.ts",
    "forecast:run": "gcloud run jobs execute ordinary-forecast --region europe-west2 --wait",
    "format": "prettier \"**/*.{css,js,json,jsx,ts,tsx,md}\"",
    "format:write": "prettier --write \"**/*.{css,js,json,jsx,ts,tsx,md}\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@beeai/cli": "^0.8.0",
    "@google-cloud/bigquery": "^9.3.0",
    "@vercel/oidc": "^4.0.1",
    "clsx": "^2.1.1",
    "compromise": "^14.19.0",
    "google-auth-library": "^11.3.1",
    "next": "^15.5.27",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "snowball-stemmers": "^0.6.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.27",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.4",
      "js-yaml": ">=4.3.2",
      "brace-expansion": ">=5.0.10",
      "handlebars": ">=4.7.10",
      "source-map-js": ">=1.2.2"
    }
  }
}
